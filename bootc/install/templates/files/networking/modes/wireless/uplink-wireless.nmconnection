[connection]
id=uplink-wireless
type=wifi
interface-name=wlan-usb
autoconnect=true
autoconnect-retries=0
zone=ext

[wifi]
mode=infrastructure
ssid=${UPLINK_SSID}
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk=${UPLINK_PSK}

[ipv4]
method=auto
ignore-auto-dns=true
dns=127.0.0.1;

[ipv6]
method=disabled
