[connection]
id=home-ap
type=wifi
interface-name=wlan-usb
autoconnect=true
autoconnect-priority=100
zone=home

[wifi]
mode=ap
band=a
channel=36
ssid=${HOME_AP_SSID}
powersave=2

[wifi-security]
key-mgmt=sae
pmf=3
proto=rsn
pairwise=ccmp
group=ccmp
psk=${HOME_AP_PSK}

[ipv4]
method=shared
address1=172.19.150.1/24

[ipv6]
method=disabled
