[connection]
id=admin-ap
uuid=${ADMIN_AP_UUID}
type=wifi
interface-name=wlan-adm
autoconnect=true
autoconnect-priority=100
zone=admin

[wifi]
mode=ap
band=bg
channel=6
ssid=mini-homelab
powersave=2

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
psk=${ADMIN_AP_PSK}

[ipv4]
method=shared
address1=172.19.149.1/24

[ipv6]
method=disabled
