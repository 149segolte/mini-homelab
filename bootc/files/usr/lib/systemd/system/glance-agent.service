[Unit]
Description=Glance Agent
After=network.target
After=k3s.service
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
# wait for cni0 to be ready
ExecStartPre=/usr/bin/sh -c 'until ip -4 -o addr show dev cni0 2>/dev/null | grep -q " 10.42.0.1/"; do sleep 2; done'
TimeoutStartSec=5min
ExecStart=/usr/bin/glance-agent --config /usr/lib/glance-agent/agent.yml
Restart=always
RestartSec=2
DynamicUser=yes

[Install]
WantedBy=multi-user.target
