<?xml version="1.0" encoding="utf-8" ?>
<policy target="DROP">
  <short>ext-to-k8s</short>
  <description
    >Upstream traffic into cluster networks: reverse proxy only.</description>
  <ingress-zone name="ext" />
  <egress-zone name="k8s" />
  <service name="http" />
  <service name="https" />
</policy>
