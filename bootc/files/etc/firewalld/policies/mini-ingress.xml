<?xml version="1.0" encoding="utf-8" ?>
<policy>
  <short>mini-ingress</short>
  <description
    >Every port the cluster serves, redirected to Traefik's fixed ClusterIP.</description>
  <ingress-zone name="home" />
  <ingress-zone name="admin" />
  <ingress-zone name="tailscale" />
  <egress-zone name="HOST" />
  <forward-port port="80" protocol="tcp" to-port="80" to-addr="10.43.0.80" />
  <forward-port port="443" protocol="tcp" to-port="443" to-addr="10.43.0.80" />
  <forward-port
        port="3922"
        protocol="tcp"
        to-port="3922"
        to-addr="10.43.0.80"
    />
</policy>
